# ==============================================================================
# AI GAME DEVELOPMENT STUDIO — MULTI-AGENT EDITION
# Environment Configuration Template
# ==============================================================================
# NEVER commit your actual API keys or secrets to Git!
# Copy this file to `.env` and fill in the values for the providers you wish to use.
# Any provider without an API key will be marked as 'unconfigured' and skipped.

# ------------------------------------------------------------------------------
# STUDIO CONFIGURATION
# ------------------------------------------------------------------------------
STUDIO_PORT=8000
STUDIO_HOST=127.0.0.1
STUDIO_DEBUG=false
STUDIO_DATA_DIR=./data
STUDIO_PROJECTS_DIR=./projects

# ------------------------------------------------------------------------------
# 1. ANTHROPIC CLAUDE (Claude 3.7 Sonnet, Claude 3.5 Sonnet, Claude 3 Opus, Haiku)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ------------------------------------------------------------------------------
# 2. OPENAI (GPT-4o, GPT-4o-mini, o1, o3-mini)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORG_ID=

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI (Gemini 2.5 Pro, Gemini 2.5 Flash, Gemini 2.0 Flash Thinking)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ------------------------------------------------------------------------------
# 4. DEEPSEEK (DeepSeek-V3, DeepSeek-R1)
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ------------------------------------------------------------------------------
# 5. MUSE (Narrative, Dialogue & Audio AI)
# ------------------------------------------------------------------------------
MUSE_API_KEY=
MUSE_BASE_URL=https://api.museai.com/v1

# ------------------------------------------------------------------------------
# 6. DOGXIAI (Game AI & Specialized Gaming Models)
# ------------------------------------------------------------------------------
DOGXIAI_API_KEY=
DOGXIAI_BASE_URL=https://api.dogxiai.com/v1

# ------------------------------------------------------------------------------
# 7. CUSTOM / LOCAL PROVIDER (vLLM, Ollama, LocalAI, LM Studio)
# ------------------------------------------------------------------------------
CUSTOM_API_KEY=
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_MODEL_NAME=llama3.3:70b

# ------------------------------------------------------------------------------
# SECURITY & RUNTIME
# ------------------------------------------------------------------------------
ALLOW_AUTO_EXECUTION=false
REQUIRE_USER_APPROVAL_FOR_WRITES=true
MAX_PARALLEL_AGENTS=5
DEFAULT_REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3
